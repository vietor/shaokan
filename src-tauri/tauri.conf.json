{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shaokan",
  "version": "1.0.0",
  "identifier": "com.github.vietor.shaokan",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shaokan",
        "width": 1100,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=LayoutNG,Translate --disable-gpu-program-cache --disable-extensions --process-per-site --disable-background-networking --disable-sync"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
